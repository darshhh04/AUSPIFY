{
    "intents": [
        {
            "tag": "greeting",
            "patterns": [
                "hello", "hi", "hey", "hi there", "hello there", "hey there",
                "good morning", "good afternoon", "good evening", "howdy",
                "greetings", "hiya"
            ],
            "responses": [
                "Hello{name_part}! How can I help you today?",
                "Hi{name_part}! What can I do for you?",
                "Hey{name_part}! Good to see you. What's on your mind?"
            ]
        },
        {
            "tag": "goodbye",
            "patterns": [
                "bye", "goodbye", "bye bye", "see you", "see ya", "see you later",
                "see you soon", "talk to you later", "catch you later",
                "i have to go", "i must go", "good night", "exit", "quit",
                "take care"
            ],
            "responses": [
                "Goodbye{name_part}! Come back anytime.",
                "See you later{name_part}! Take care.",
                "Bye{name_part}! Have a great day."
            ]
        },
        {
            "tag": "thanks",
            "patterns": [
                "thanks", "thank you", "thanks a lot", "thank you so much",
                "many thanks", "thx", "i appreciate it", "that was helpful",
                "thanks for the help"
            ],
            "responses": [
                "You're welcome{name_part}!",
                "Happy to help!",
                "Anytime{name_part}! Anything else I can do?"
            ]
        },
        {
            "tag": "how_are_you",
            "description": "how I am doing",
            "patterns": [
                "how are you", "how are you doing", "how is it going",
                "how do you do", "how do you feel", "how is your day",
                "how have you been", "what is up", "whats up", "are you okay"
            ],
            "responses": [
                "I'm doing great, thanks for asking! How are you?",
                "All systems running smoothly! How are you feeling today?",
                "Doing well, thank you. What about you?"
            ]
        },
        {
            "tag": "feeling_good",
            "patterns": [
                "i am fine", "i am good", "i am great", "i am doing well",
                "im doing great", "i feel good", "i am happy", "pretty good",
                "not bad", "i am okay"
            ],
            "responses": [
                "Glad to hear that! Anything I can help with today?",
                "That's great news! What would you like to talk about?",
                "Nice! A good mood makes everything easier."
            ]
        },
        {
            "tag": "feeling_bad",
            "patterns": [
                "i am sad", "i feel sad", "i am tired", "i am stressed",
                "i am bored", "i feel bad", "i am not feeling well",
                "not good", "i am having a bad day", "i feel lonely"
            ],
            "responses": [
                "I'm sorry you feel that way. A short break, a walk or a chat with a friend can really help. Want a joke or some motivation?",
                "That sounds hard. Take a few slow breaths, and if it feels heavy, talk to someone you trust. I can also tell you a joke if you like."
            ]
        },
        {
            "tag": "bot_identity",
            "description": "who I am",
            "patterns": [
                "who are you", "what are you", "what is your name",
                "tell me about yourself", "introduce yourself",
                "are you a robot", "are you human", "are you a bot",
                "what should i call you"
            ],
            "responses": [
                "I'm {bot_name}, a chatbot written in Python. I use simple NLP, like tokenizing, stemming and TF-IDF matching, to work out what you mean."
            ]
        },
        {
            "tag": "creator",
            "description": "who made me",
            "patterns": [
                "who made you", "who created you", "who built you",
                "who developed you", "who programmed you",
                "who is your creator", "who is your developer"
            ],
            "responses": [
                "I was written in Python as an internship project, using only the standard library."
            ]
        },
        {
            "tag": "bot_age",
            "patterns": [
                "how old are you", "what is your age", "when were you born",
                "when were you created"
            ],
            "responses": [
                "I'm brand new! I only exist while this program is running.",
                "Age is just a number, and mine is one chat session old."
            ]
        },
        {
            "tag": "help",
            "description": "what I can do",
            "patterns": [
                "help", "help me", "what can you do", "how can you help me",
                "what can i ask you", "what do you know", "show me your features",
                "list your features", "what are your abilities", "commands",
                "can you help me"
            ],
            "responses": [
                "Here is what I can do:\n- Chat and small talk\n- Tell jokes\n- Give Python, study and motivation tips\n- Tell the time and date\n- Do simple maths, like 'calculate 12 * 7'\n- Remember your name if you say 'my name is ...'"
            ]
        },
        {
            "tag": "time",
            "description": "the time",
            "patterns": [
                "what time is it", "tell me the time", "current time",
                "time now", "what is the time", "do you know the time",
                "what is the current time", "whats the time right now"
            ],
            "responses": [
                "It's {time} right now.",
                "The time is {time}."
            ]
        },
        {
            "tag": "date",
            "description": "today's date",
            "patterns": [
                "what is the date today", "todays date", "what day is it",
                "which day is today", "what is today", "current date",
                "tell me the date", "what is the date", "what day is today"
            ],
            "responses": [
                "Today is {date}.",
                "It's {date}."
            ]
        },
        {
            "tag": "joke",
            "description": "a joke",
            "repeatable": true,
            "patterns": [
                "tell me a joke", "joke", "say something funny",
                "make me laugh", "i want a joke", "do you know any jokes",
                "tell me something funny", "tell a joke", "give me a joke",
                "i want to laugh", "funny"
            ],
            "responses": [
                "Why do programmers prefer dark mode? Because light attracts bugs.",
                "Why did the developer go broke? Because he used up all his cache.",
                "There are 10 types of people: those who understand binary and those who don't.",
                "A SQL query walks into a bar, walks up to two tables and asks: 'Can I join you?'",
                "I would tell you a UDP joke, but you might not get it.",
                "Debugging: being the detective in a crime movie where you are also the murderer."
            ]
        },
        {
            "tag": "python_tips",
            "description": "programming tips",
            "repeatable": true,
            "patterns": [
                "python tips", "how to learn python", "how do i learn python",
                "python help", "tips for programming",
                "how can i become a better programmer", "coding tips",
                "programming advice", "how to improve my coding",
                "i want to learn programming", "give me a coding tip"
            ],
            "responses": [
                "Practice a little every day. Build small projects, like a calculator or a to-do app, instead of only watching tutorials.",
                "Read error messages from the bottom up. The last line usually tells you what went wrong.",
                "Break big problems into small functions and give your variables clear names.",
                "Get to know the standard library first: json, csv, datetime, random and collections solve a lot of problems.",
                "Print values or use a debugger to see what your code really does, instead of guessing."
            ]
        },
        {
            "tag": "study_tips",
            "description": "study tips",
            "repeatable": true,
            "patterns": [
                "study tips", "how to study", "how can i study better",
                "how to focus while studying", "how do i concentrate",
                "exam tips", "how to prepare for exams", "study advice",
                "help me study", "how can i improve my focus"
            ],
            "responses": [
                "Try the Pomodoro method: study for 25 minutes, then take a 5 minute break.",
                "Explain what you learned out loud, as if teaching a friend. The gaps show up quickly.",
                "Test yourself instead of rereading. Practice questions beat highlighting.",
                "Keep your phone in another room while you study. Focus gets much easier."
            ]
        },
        {
            "tag": "motivation",
            "description": "some motivation",
            "repeatable": true,
            "patterns": [
                "motivate me", "i need motivation", "give me some motivation",
                "inspire me", "i feel lazy", "cheer me up", "encourage me",
                "say something inspiring", "i need inspiration"
            ],
            "responses": [
                "Small steps still move you forward. Do the next tiny task and the rest gets easier.",
                "You don't have to be perfect, you just have to start.",
                "Progress beats perfection. One finished page is better than ten perfect plans.",
                "Every expert was once a beginner who kept going."
            ]
        },
        {
            "tag": "weather",
            "description": "the weather",
            "patterns": [
                "what is the weather", "how is the weather",
                "will it rain today", "weather today",
                "how hot is it outside", "is it raining", "weather forecast",
                "what is the temperature"
            ],
            "responses": [
                "I can't check live weather because I'm not connected to a weather service. A weather app or website will give you an accurate forecast."
            ]
        },
        {
            "tag": "set_name",
            "patterns": [],
            "responses": [
                "Nice to meet you, {user_name}! I'll remember your name."
            ]
        },
        {
            "tag": "ask_name",
            "description": "your name",
            "patterns": [
                "what is my name", "do you know my name", "who am i",
                "remember my name", "can you remember my name"
            ],
            "responses": [
                "Your name is {user_name}."
            ]
        },
        {
            "tag": "compliment",
            "patterns": [
                "you are smart", "you are awesome", "good bot", "nice work",
                "you are helpful", "great job", "well done", "you are amazing",
                "i like you", "you are funny"
            ],
            "responses": [
                "Thank you, that's kind of you!",
                "Aw, thanks{name_part}! I'm happy I could help.",
                "That made my day. Thank you!"
            ]
        },
        {
            "tag": "more",
            "patterns": [
                "another one", "one more", "again", "tell me another",
                "more", "next one", "another"
            ],
            "responses": []
        },
        {
            "tag": "acknowledge",
            "patterns": [
                "ok", "okay", "cool", "alright", "got it", "nice", "fine",
                "sounds good", "great"
            ],
            "responses": [
                "Great! Let me know if you need anything else.",
                "Okay! I'm here whenever you want to chat."
            ]
        },
        {
            "tag": "fallback",
            "patterns": [],
            "responses": [
                "Sorry, I didn't understand that. Try asking for a joke, the time, a Python tip, or type 'help' to see everything I can do.",
                "Hmm, I'm not sure what you mean. I'm still learning! Type 'help' to see what I can talk about.",
                "I didn't catch that. Could you say it in a different way?"
            ]
        }
    ]
}